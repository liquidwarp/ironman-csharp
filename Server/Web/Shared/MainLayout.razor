@using IronManServer.Config
@using IronManServer.Models.Enums
@using Color = MudBlazor.Color
@inherits LayoutComponentBase

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ConfigManager ConfigManager
@inject Helpers.Utils ImUtils

<HeadContent>
    <link href="/acidphantasm-ironman/css/app.css" rel="stylesheet" />
</HeadContent>

<MudThemeProvider Theme="@_themeAdjustments" IsDarkMode="true" />
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<div class="ironman-app no-highlight">
    <MudLayout>

        <MudAppBar Dense="true"
                   Elevation="0"
                   Class="ironman-appbar">

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.MenuOpen"
                       Class="ironman-toolbar-button"
                       OnClick="@(_ => DrawerToggle())">
                Menu
            </MudButton>

            <MudSpacer />

            <div class="ironman-brand">
                <div class="ironman-brand-mark"></div>
                <div class="ironman-brand-text">
                    <span class="ironman-brand-title">IRONMAN</span>
                    <span class="ironman-brand-subtitle">SERVER CONFIGURATION</span>
                </div>
            </div>

            <MudSpacer />

            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       Class="ironman-toolbar-button"
                       OnClick="@(_ => RefreshData())"
                       Disabled="_isReloading">

                @if (_isReloading)
                {
                    <MudProgressCircular Class="ironman-button-progress"
                                         Size="Size.Small"
                                         Indeterminate="true" />
                }
                else
                {
                    <span>Reload Config</span>
                }
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Save"
                       Class="ironman-save-button"
                       OnClick="@(_ => SaveData())"
                       Disabled="_isSaving">

                @if (_isSaving)
                {
                    <MudProgressCircular Class="ironman-button-progress"
                                         Size="Size.Small"
                                         Indeterminate="true" />
                }
                else
                {
                    <span>Save Config</span>
                }
            </MudButton>

        </MudAppBar>

        <MudDrawer @bind-Open="_drawerOpen"
                   Elevation="0"
                   ClipMode="DrawerClipMode.Always"
                   Variant="DrawerVariant.Temporary"
                   Breakpoint="Breakpoint.None"
                   Class="ironman-drawer">

            <MudDrawerHeader Class="ironman-drawer-header">
                <div class="ironman-drawer-title">
                    <span class="ironman-drawer-title-main">SETTINGS</span>
                    <span class="ironman-drawer-title-line"></span>
                </div>
            </MudDrawerHeader>

            <NavMenu />

        </MudDrawer>

        <MudMainContent Class="ironman-main-content">

            <div class="ironman-content-background"></div>

            @if (AppDisableAnimations)
            {
                <div class="ironman-content no-animation-content">
                    @Body
                </div>
            }
            else
            {
                <div class="ironman-content content">
                    @Body
                </div>
            }

        </MudMainContent>

        <MudAppBar Dense="true"
                   Elevation="0"
                   Bottom="true"
                   Class="ironman-statusbar">

            <div class="ironman-status-options">

                <MudCheckBox @bind-Value="AppDisableAnimations"
                             Dense="true"
                             Label="Disable Animations"
                             Class="ironman-checkbox" />

                <MudCheckBox @bind-Value="AppAllowUpdateChecks"
                             Dense="true"
                             Label="Enable Update Checks"
                             Class="ironman-checkbox" />

                <MudCheckBox @bind-Value="ShowDefaultButton"
                             Dense="true"
                             Label="Show Default Button"
                             Class="ironman-checkbox" />

            </div>

            <MudSpacer />
            
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.Home"
                       Href="/"
                       Class="ironman-toolbar-button">
                Back to SIC
            </MudButton>
            
            <MudSpacer />

            @if (PendingChanges.Count > 0)
            {
                <MudButton Variant="Variant.Filled"
                           Class="ironman-pending-button"
                           OnClick="ShowPendingChanges">

                    <span class="ironman-pending-count">
                        @PendingChanges.Count
                    </span>

                    <span>
                        @(PendingChanges.Count == 1
                            ? "Unsaved change"
                            : "Unsaved changes")
                    </span>

                </MudButton>
            }
            else
            {
                <div class="ironman-clean-status">
                    <span class="ironman-status-indicator"></span>
                    <span>No unsaved changes</span>
                </div>
            }

        </MudAppBar>

    </MudLayout>
</div>

<style>
    .no-highlight {
        -webkit-user-drag: none;
        -webkit-user-select: none;
        user-select: none;
    }
</style>

@code {
    private static MainLayout? _app;

    private bool _drawerOpen;

    private static bool _unsavedChanges;

    public static readonly List<string> PendingChanges = [];

    private bool _isSaving;
    private bool _isReloading;

    public bool AppDisableAnimations
    {
        get => ConfigManager.RuntimeConfig.ConfigAppSettings.DisableAnimations;
        set
        {
            ConfigManager.RuntimeConfig.ConfigAppSettings.DisableAnimations = value;
            ImUtils.UpdateView(value, ConfigManager.OriginalConfig.ConfigAppSettings.DisableAnimations);
        }
    }

    public bool AppAllowUpdateChecks
    {
        get => ConfigManager.RuntimeConfig.ConfigAppSettings.AllowUpdateChecks;
        set
        {
            ConfigManager.RuntimeConfig.ConfigAppSettings.AllowUpdateChecks = value;
            ImUtils.UpdateView(value, ConfigManager.OriginalConfig.ConfigAppSettings.AllowUpdateChecks);
        }
    }

    public bool ShowDefaultButton
    {
        get => ConfigManager.RuntimeConfig.ConfigAppSettings.ShowDefaultButton;
        set
        {
            ConfigManager.RuntimeConfig.ConfigAppSettings.ShowDefaultButton = value;
            ImUtils.UpdateView(value, ConfigManager.OriginalConfig.ConfigAppSettings.ShowDefaultButton);
        }
    }

    private readonly MudTheme _themeAdjustments = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#7A2028",
            Secondary = "#907B6B",

            Background = "#0F0A0D",
            Surface = "#181114",

            DrawerBackground = "#120C0F",
            DrawerText = "#D9CBBE",
            DrawerIcon = "#907B6B",

            AppbarBackground = "#170C10",
            AppbarText = "#E0D6C5",

            TextPrimary = "#E0D6C5",
            TextSecondary = "#B9AAA0",
            TextDisabled = "#6D625D",

            ActionDefault = "#907B6B",
            ActionDisabled = "#665A54",
            ActionDisabledBackground = "#241B1F",

            LinesDefault = "#302328",
            TableLines = "#302328",
            TableStriped = "#1C1418",

            Success = "#8C9A72",
            Info = "#8A9BA8",
            Warning = "#C29A68",
            Error = "#B0302A",
        }
    };

    public MainLayout()
    {
        _app = this;
    }

    public static void EnableUnsavedChangesButton()
    {
        _unsavedChanges = true;
        _app?.StateHasChanged();
    }

    public static void TriggerUIRefresh()
    {
        _app?.StateHasChanged();
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task SaveData()
    {
        try
        {
            _isSaving = true;
            StateHasChanged();

            var result = await ConfigManager.SaveConfig();

            StateHasChanged();

            switch (result)
            {
                case ConfigOperationResult.Success:
                    Snackbar.Add(
                        "Config saved successfully.",
                        Severity.Info,
                        config => config.ShowCloseIcon = false);

                    PendingChanges.Clear();
                    _unsavedChanges = false;
                    break;

                case ConfigOperationResult.ActiveProcess:
                    Snackbar.Add(
                        "Another process is already running.",
                        Severity.Warning,
                        config => config.ShowCloseIcon = false);
                    break;

                case ConfigOperationResult.Failure:
                default:
                    Snackbar.Add(
                        "Config failed to save.",
                        Severity.Error,
                        config => config.ShowCloseIcon = false);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unexpected error: {ex.Message}",
                Severity.Error,
                config => config.ShowCloseIcon = false);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task RefreshData()
    {
        if (_unsavedChanges || PendingChanges.Count > 0)
        {
            var changeCount = PendingChanges.Count switch
            {
                > 1 => $"{PendingChanges.Count} unsaved changes",
                1 => "1 unsaved change",
                _ => "unsaved changes"
            };

            var parameters = new DialogParameters<RefreshWarningDialog>
            {
                { x => x.ChangeList, PendingChanges },
                { x => x.ButtonText, "Reload Anyway" },
                { x => x.Color, Color.Secondary }
            };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                BackgroundClass = "custom-blur-background"
            };

            var dialog = await DialogService.ShowAsync<RefreshWarningDialog>(
                $"You have {changeCount}.",
                parameters,
                options);

            var result = await dialog.Result;

            if (result is not null && !result.Canceled)
            {
                await DiscardChangesAndReload();
            }

            return;
        }

        try
        {
            _isReloading = true;
            StateHasChanged();

            var result = await ConfigManager.ReloadConfig();

            StateHasChanged();

            switch (result)
            {
                case ConfigOperationResult.Success:
                    Snackbar.Add(
                        "Config reloaded successfully.",
                        Severity.Info,
                        cfg => cfg.ShowCloseIcon = false);

                    _unsavedChanges = false;
                    PendingChanges.Clear();
                    break;

                case ConfigOperationResult.ActiveProcess:
                    Snackbar.Add(
                        "Another process is already running.",
                        Severity.Warning,
                        cfg => cfg.ShowCloseIcon = false);
                    break;

                case ConfigOperationResult.Failure:
                default:
                    Snackbar.Add(
                        "Config failed to reload.",
                        Severity.Error,
                        cfg => cfg.ShowCloseIcon = false);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unexpected error: {ex.Message}",
                Severity.Error,
                cfg => cfg.ShowCloseIcon = false);
        }
        finally
        {
            _isReloading = false;
            StateHasChanged();
        }
    }

    private async Task ShowPendingChanges()
    {
        var changeCount = PendingChanges.Count switch
        {
            > 1 => $"{PendingChanges.Count} changes",
            1 => "1 change",
            _ => "changes"
        };

        var parameters = new DialogParameters<RefreshWarningDialog>
        {
            { x => x.ChangeList, PendingChanges },
            { x => x.ButtonText, "OK" },
            { x => x.ShowCancel, false },
            { x => x.Color, Color.Default }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            BackgroundClass = "custom-blur-background"
        };

        await DialogService.ShowAsync<RefreshWarningDialog>(
            $"You have {changeCount}.",
            parameters,
            options);
    }

    private async Task DiscardChangesAndReload()
    {
        var changeCount = PendingChanges.Count switch
        {
            > 1 => $"{PendingChanges.Count} changes",
            1 => "1 change",
            _ => "changes"
        };

        try
        {
            _isReloading = true;
            StateHasChanged();

            var result = await ConfigManager.ReloadConfig();

            switch (result)
            {
                case ConfigOperationResult.Success:
                    Snackbar.Add(
                        $"{changeCount} discarded and config reloaded.",
                        Severity.Warning,
                        cfg => cfg.ShowCloseIcon = false);

                    PendingChanges.Clear();
                    _unsavedChanges = false;
                    break;

                case ConfigOperationResult.ActiveProcess:
                    Snackbar.Add(
                        "Another process is already running.",
                        Severity.Warning,
                        cfg => cfg.ShowCloseIcon = false);
                    break;

                case ConfigOperationResult.Failure:
                default:
                    Snackbar.Add(
                        "Config failed to reload.",
                        Severity.Error,
                        cfg => cfg.ShowCloseIcon = false);
                    break;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unexpected error: {ex.Message}",
                Severity.Error,
                cfg => cfg.ShowCloseIcon = false);
        }
        finally
        {
            _isReloading = false;
            StateHasChanged();
        }
    }
}